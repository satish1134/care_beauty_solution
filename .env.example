# Environment Configuration for CARe - A Beauty Solution
# Core Server & Application
NODE_ENV=development
PORT=3000
APP_VERSION=1.0.0
GIT_COMMIT_SHA=dev-local

# PostgreSQL Database
DATABASE_URL=postgresql://care_user:care_password@localhost:5432/care_beauty?schema=public

# Redis / Caching & BullMQ
REDIS_URL=redis://localhost:6379

# Object Storage for CMS Media (S3 / Cloud Storage / Local)
STORAGE_PROVIDER=local
STORAGE_BUCKET=care-beauty-media
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# Observability & Monitoring
LOG_LEVEL=INFO
SENTRY_ENVIRONMENT=development
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Security & Admin Authentication
ADMIN_JWT_SECRET=super-secret-admin-jwt-token-replace-in-production
SESSION_COOKIE_NAME=care_admin_session
